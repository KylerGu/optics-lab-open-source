# Public deployments set the process variable APP_ENV=production (see render.yaml
# and the Docker image). That turns off debug logs, /docs, /redoc and /openapi.json,
# and adds security headers. Leave it unset for local `npm run dev`.
#
# Leave this unset on a public website. Visitors then enter their own DeepSeek key
# in the browser. Set it to 1 only for a private or local server that should use
# the key below when a visitor has not configured one.
AI_ALLOW_SERVER_KEY=

# Used only when AI_ALLOW_SERVER_KEY=1. Browser keys do not read these values.
# Official DeepSeek base URL. Include /v1 only if your client requires it.
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_API_KEY=

# Official DeepSeek endpoint only: none / low / high / max. Default: high.
AI_REASONING_EFFORT=high

# Research Agent and delegated builder: default high, independently configurable.
# These apply only to the server key above, not to a key saved in the browser.
AI_RESEARCH_REASONING_EFFORT=high
AI_RESEARCH_BUILD_REASONING_EFFORT=high
